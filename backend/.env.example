APP_NAME=activio-api
APP_ENV=development
DEBUG=true

POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=activio
POSTGRES_USER=activio
POSTGRES_PASSWORD=change-me
DATABASE_URL=postgresql+psycopg://activio:change-me@localhost:5432/activio

JWT_SECRET_KEY=replace-with-a-long-random-secret
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

# Google AI Studio key; keep this server-side and never commit a real key.
GEMINI_API_KEY=your_google_ai_studio_api_key
GEMINI_MODEL=gemini-3.6-flash
# Optional override for a compatible test endpoint.
# GEMINI_API_URL=https://generativelanguage.googleapis.com/v1beta/models/{model}:generateContent
# Comma-separated browser origins allowed to call the API.
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
